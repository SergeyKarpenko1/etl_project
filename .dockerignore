# -----------------------------
# Python bytecode and cache
# -----------------------------
__pycache__/
*.pyc
*.pyo
*.pyd

# -----------------------------
# Virtual environments
# -----------------------------
.venv/
venv/
env/

# -----------------------------
# Jupyter notebooks and temporary files
# -----------------------------
notebooks/
*.ipynb_checkpoints/

# -----------------------------
# Data (raw, processed, example)
# Исключаем для уменьшения размера контекста.
# Если данные нужны в контейнере — переносить их в отдельный volume.
# -----------------------------
data/

# -----------------------------
# Test files
# В прод-образ они не нужны.
# -----------------------------
tests/

# -----------------------------
# Build and packaging artifacts
# -----------------------------
build/
dist/
*.egg-info/

# -----------------------------
# Logs and temporary files
# -----------------------------
*.log
*.tmp

# -----------------------------
# Documentation
# В runtime не используется.
# -----------------------------
docs/

# -----------------------------
# IDE / editor files
# -----------------------------
.idea/
.vscode/
*.iml

# -----------------------------
# System files
# -----------------------------
.DS_Store
Thumbs.db

# -----------------------------
# Environment / secrets
# -----------------------------
*.env
.env.*
secrets/